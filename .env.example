RAWIAI_USE_LIVE_APIS=false
RAWIAI_USE_GEMINI=false

NOKIA_API_KEY=
NOKIA_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
NOKIA_TEST_PHONE_NUMBER=+99999991000
# Must be a publicly reachable HTTPS URL that routes to POST /geofence on
# this app's backend. After `reflex deploy`, run `reflex cloud apps inspect
# <app-id> --json` and use its "backend_url" + "/geofence".
NOKIA_GEOFENCE_SINK_URL=
RAWIAI_APPLICATION_SERVER_IPV4=8.8.8.8
NOKIA_QOS_PROFILE=DOWNLINK_M_UPLINK_L

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

RAWIAI_USE_QDRANT=false
QDRANT_URL=http://localhost:6333

# Real SMS-triggered entry (the "Amina gets an SMS" moment from the pitch
# deck). Needs a real Twilio account - console.twilio.com, a purchased
# sending number, and its Account SID from the dashboard.
RAWIAI_USE_SMS=false
TWILIO_ACCOUNT_SID=
# Auth via either the Account Auth Token (classic) ...
TWILIO_AUTH_TOKEN=
# ... or a Twilio API Key (SID starts with "SK") instead - the Account SID
# above is still required regardless, since it's part of the request URL.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
# Public link sent in the SMS. Defaults to the current Reflex Cloud
# deployment URL if left blank.
RAWIAI_APP_URL=
